# Ignore notes.txt
notes.txt

# Ignore TTS generated bundles
bundled/

# Ignore all object scripts by default
*.*.lua
*.*.xml
*.json

# Allow Global lua scripts
!Global.-1.lua

# Allow VSCode settings
!.vscode/*.json

# Explicitly track only objects actively scripted (by GUID or name)
!*Die.*.lua
!Custom_Board*.lua